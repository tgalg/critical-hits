# Local development only; credentials match docker-compose.yml.
DATABASE_URL=postgresql://critical_hits:critical_hits@localhost:5432/critical_hits
# Disposable database for schema tests; the suite drops and recreates its schema.
# Create it once: docker compose exec db createdb -U critical_hits critical_hits_test
TEST_DATABASE_URL=postgresql://critical_hits:critical_hits@localhost:5432/critical_hits_test
# Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Optional: Discord sign-in appears only when both are set.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# IGDB catalog sync: a Twitch developer app from https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Bearer token Vercel Cron sends to /api/cron/igdb-sync. Generate with: openssl rand -base64 32
CRON_SECRET=
# Moderators' emails, comma-separated. Only verified emails (e.g. from Discord sign-in) count.
ADMIN_EMAILS=
# Optional: while set, new accounts need this invite code on /sign-up (closed beta).
SIGNUP_INVITE_CODE=
