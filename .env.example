# Local development only; credentials match docker-compose.yml.
DATABASE_URL=postgresql://critical_hits:critical_hits@localhost:5432/critical_hits
# Disposable database for schema tests; the suite drops and recreates its schema.
# Create it once: docker compose exec db createdb -U critical_hits critical_hits_test
TEST_DATABASE_URL=postgresql://critical_hits:critical_hits@localhost:5432/critical_hits_test
# Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Optional: Discord sign-in appears only when both are set.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
